local main = Instance.new("Frame") main.Size = UDim2.new(0, 230, 0, 300) main.Position = UDim2.new(0.5, -115, 0.5, -150) main.BackgroundColor3 = COLOR_BG main.BorderSizePixel = 0 main.Parent = gui corner(main, 10)

