-- ปุ่มลอยเปิด/ปิดเมนู local openBtn = Instance.new("TextButton") openBtn.Size = UDim2.new(0, 44, 0, 44) openBtn.Position = UDim2.new(0, 10, 0.5, -22) openBtn.BackgroundColor3 = COLOR_BG openBtn.Text = "👁" openBtn.TextSize = 22 openBtn.TextColor3 = Color3.new(1, 1, 1) openBtn.Visible = false openBtn.Parent = gui corner(openBtn, 22)

-- ลากได้ local function makeDraggable(handle, target) local dragging, dragStart, startPos, moved handle.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true moved = false dragStart = input.Position startPos = target.Position input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end) end end) UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then local d = input.Position - dragStart if d.Magnitude > 5 then moved = true end target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y) end end) return function() return moved end end

makeDraggable(main, main) local openMoved = makeDraggable(openBtn, openBtn)

closeBtn.MouseButton1Click:Connect(function() main.Visible = false openBtn.Visible = true end) openBtn.MouseButton1Click:Connect(function() if openMoved() then return end main.Visible = true openBtn.Visible = false end)

-- ฟังก์ชัน 1: เลือกผู้เล่น local function updateStatus() if selected then status.Text = "เลือก: " .. selected.DisplayName .. " (@" .. selected.Name .. ")" else status.Text = "ยังไม่ได้เลือกผู้เล่น" end end

local function selectPlayer(plr) selected = plr for p, btn in pairs(rows) do btn.BackgroundColor3 = (p == plr) and COLOR_SEL or COLOR_ITEM end updateStatus() end

-- ฟังก์ชัน 2: รีรายชื่อผู้เล่น local function refreshList() for _, btn in pairs(rows) do btn:Destroy() end rows = {}

 
for _, plr in ipairs(Players:GetPlayers()) do
	if plr ~= LocalPlayer then
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 28)
		btn.BackgroundColor3 = (plr == selected) and COLOR_SEL or COLOR_ITEM
		btn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
		btn.TextColor3 = Color3.new(1, 1, 1)
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 12
		btn.TextTruncate = Enum.TextTruncate.AtEnd
		btn.Parent = list
		corner(btn, 6)
		btn.MouseButton1Click:Connect(function() selectPlayer(plr) end)
		rows[plr] = btn
	end
end

-- ถ้าคนที่เลือกออกไปแล้ว ให้เคลียร์
if selected and not rows[selected] then
	selected = nil
	updateStatus()
end
 

end

refreshBtn.MouseButton1Click:Connect(refreshList) Players.PlayerRemoving:Connect(function() task.defer(refreshList) end)

-- ฟังก์ชัน 3: เปิด/ปิดหันหน้าตาม local function setCharacterAutoRotate(value) local char = LocalPlayer.Character local hum = char and char:FindFirstChildOfClass("Humanoid") if hum then hum.AutoRotate = value end end

local function setEnabled(state) enabled = state toggleBtn.Text = "หันหน้าตาม: " .. (enabled and "เปิด" or "ปิด") toggleBtn.BackgroundColor3 = enabled and COLOR_ON or COLOR_OFF if not enabled then setCharacterAutoRotate(true) end end

toggleBtn.MouseButton1Click:Connect(function() if not enabled and not selected then status.Text = "กรุณาเลือกผู้เล่นก่อน!" return end setEnabled(not enabled) end)

-- ลูปหันหน้า RunService.Heartbeat:Connect(function() if not enabled then return end if not selected or not selected.Parent then setEnabled(false) return end

 
local myChar = LocalPlayer.Character
local targetChar = selected.Character
local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
if not (myHRP and targetHRP) then return end

local hum = myChar:FindFirstChildOfClass("Humanoid")
if hum then hum.AutoRotate = false end

local myPos = myHRP.Position
local lookAt = Vector3.new(targetHRP.Position.X, myPos.Y, targetHRP.Position.Z)
if (lookAt - myPos).Magnitude > 0.1 then
	myHRP.CFrame = CFrame.new(myPos, lookAt)
end
 

end)

